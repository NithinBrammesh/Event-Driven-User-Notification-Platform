# Shared
PROJECT_NAME=astra-test

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
USER_SERVICE_DB=user_service_db
NOTIFICATION_SERVICE_DB=notification_service_db

# NATS
NATS_URL=nats://nats:4222
NATS_USERNAME=replace_with_nats_username
NATS_PASSWORD=replace_with_nats_password
NATS_HTTP_PORT=8222
NATS_STREAM=user_events
NATS_SUBJECT=user.created
NATS_CONSUMER_NAME=notification-service

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

# User Service
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=8001
USER_SERVICE_DATABASE_URL=postgresql+psycopg://postgres:change_me@postgres:5432/user_service_db

# Notification Service
NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=8002
NOTIFICATION_SERVICE_DATABASE_URL=postgresql+psycopg://postgres:change_me@postgres:5432/notification_service_db
